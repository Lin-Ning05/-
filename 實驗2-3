# 1. 寫一個計算當前 Epoch 學習率的數學函數
def warmup_cosine_decay_scheduler(epoch, lr):
    total_epochs = 50
    warmup_epochs = 5      # 前 5 個 Epoch 做 Warmup
    init_lr = 1e-3         # 目標最高學習率
    min_lr = 1e-5          # 最低學習率

    # 階段 1：Warmup 階段 (從 0 線性拉升至 init_lr)
    if epoch < warmup_epochs:
        return init_lr * (epoch + 1) / warmup_epochs

    # 階段 2：Cosine Decay 餘弦退火階段
    progress = (epoch - warmup_epochs) / (total_epochs - warmup_epochs)
    cosine_decay = 0.5 * (1.0 + math.cos(math.pi * progress))
    return min_lr + (init_lr - min_lr) * cosine_decay

# 2. 包裝成 Keras Callback
lr_warmup_cosine_cb = LearningRateScheduler(warmup_cosine_decay_scheduler, verbose=1)

# 在 fit 時傳入 callbacks
history = model.fit(
    train_ds,
    validation_data=val_ds,
    epochs=50,
    callbacks = [lr_warmup_cosine_cb, checkpoint]
)

