def inception_block(x, filters):
    # Branch 1：1×1 Conv
    branch1 = layers.Conv2D(filters, (1,1), padding='same', activation='relu')(x)

    # Branch 2：3×3 Conv
    branch2 = layers.Conv2D(filters//2, (1,1), padding='same', activation=None)(x)
    branch2 = layers.BatchNormalization()(branch2)
    branch2 = layers.Activation("relu")(branch2)
    branch2 = layers.Conv2D(filters, (3,3), padding='same', activation=None)(branch2)
    branch2 = layers.BatchNormalization()(branch2)
    branch2 = layers.Activation("relu")(branch2)

    # Branch 3：3×1 → 1×3 (非對稱卷積)
    branch3 = layers.Conv2D(filters, (3,1), padding='same', activation='relu')(x)
    branch3 = layers.Conv2D(filters, (1,3), padding='same', activation='relu')(branch3)

    # Branch 4：Pooling
    branch4 = layers.MaxPooling2D(pool_size=(3,3), strides=1, padding='same')(x)
    branch4 = layers.Conv2D(filters, (1,1), padding='same', activation='relu')(branch4)

    # Concatenate
    x = layers.Concatenate()([
        branch1,
        branch2,
        branch3,
        branch4
    ])
    return x


inputs = keras.Input(shape=(img_height, img_width, 3))

x = data_augmentation(inputs)
x = layers.Rescaling(1./255)(x)
x = layers.Conv2D(32, 5, padding='same', activation='relu')(x)
x = layers.BatchNormalization()(x)
x = layers.MaxPooling2D()(x)

# 第二個卷積區塊
x = layers.Conv2D(64, 5, padding='same', activation='relu')(x)
x = layers.BatchNormalization()(x)
x = layers.MaxPooling2D()(x)


# 第三個卷積區塊
# 改成 Inception Block
x = inception_block(x, 64)
x = layers.BatchNormalization()(x)
x = layers.MaxPooling2D()(x)

x = layers.Conv2D(128,3, padding='same', activation='relu')(x)
x = layers.BatchNormalization()(x)
x = layers.MaxPooling2D()(x)

x = layers.Conv2D(128,3, padding='same', activation='relu')(x)
x = layers.BatchNormalization()(x)
x = layers.MaxPooling2D()(x)

x = layers.Dropout(0.2)(x)
x = layers.Flatten()(x)
x = layers.Dense(128, activation='relu')(x)
x = layers.Dropout(0.2)(x)
outputs = layers.Dense(num_classes)(x)

model = keras.Model(inputs, outputs)


model.summary()

model.compile(optimizer='adam',
       loss=tf.keras.losses.SparseCategoricalCrossentropy(from_logits=True),
       metrics=['accuracy'])

checkpoint = ModelCheckpoint(
    'best_model.keras',
    monitor='val_loss',
    save_best_only=True
)

