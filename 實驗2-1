# TensorFlow and tf.keras
import tensorflow as tf

# Helper libraries
import numpy as np
import matplotlib.pyplot as plt

print(tf.__version__)

fashion_mnist = tf.keras.datasets.fashion_mnist #TensorFlow 提供的一個資料集模組其中的服飾資料集

(train_images, train_labels), (test_images, test_labels) = fashion_mnist.load_data() #載入資料及資料 (load_data會檢查本地端有沒有資料沒有的話才去下載)
#60,000張訓練圖片 10,000張測試圖片 (28*28*1)灰階
class_names = ['T-shirt/top', 'Trouser', 'Pullover', 'Dress', 'Coat',
               'Sandal', 'Shirt', 'Sneaker', 'Bag', 'Ankle boot']

#灰階影像0代表黑色255代表白色，除255讓資料回到0~1之間
#reshape重新改變NumPy陣列的維度 (-1試只請其自動計算這個維度的大小，這樣資料修改就不用自己調)
train_images = (train_images / 255.0).reshape(-1, 28, 28, 1)
test_images = (test_images / 255.0).reshape(-1, 28, 28, 1)

#資料增強模型(因為原本測試的模型有出現過擬合的現象或是測試資料與訓練圖片差異過大)
data_augmentation = tf.keras.Sequential([
    #隨機水平翻轉層，預設50%機率翻轉("horizontal"只允許水平翻轉、vertical上下翻轉)
    #只採用水平翻轉，因為大多數的衣服鞋子左右顛倒差異並不大
    tf.keras.layers.RandomFlip("horizontal"),
    # 僅允許約 +- 1.8 度的極微幅旋轉 (0.005*360°)
    tf.keras.layers.RandomRotation(factor=0.005)
])


model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(28, 28, 1)),
    data_augmentation, #加入設定好的資料增強

    tf.keras.layers.Conv2D(filters=32, kernel_size=(3, 3), activation='relu', padding='same'),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.Conv2D(filters=32, kernel_size=(3, 3), activation='relu', padding='same'),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.MaxPooling2D(pool_size=(2, 2)),
    tf.keras.layers.Dropout(0.2),

    tf.keras.layers.Conv2D(filters=64, kernel_size=(3, 3), activation='relu', padding='same'),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.Conv2D(filters=64, kernel_size=(3, 3), activation='relu', padding='same'),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.MaxPooling2D(pool_size=(2, 2)),
    tf.keras.layers.Dropout(0.2),

    tf.keras.layers.Conv2D(filters=128, kernel_size=(3, 3), activation='relu', padding='same'),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.Conv2D(filters=128, kernel_size=(3, 3), activation='relu', padding='same'),
    tf.keras.layers.BatchNormalization(),
    tf.keras.layers.MaxPooling2D(pool_size=(2, 2)),
    tf.keras.layers.Dropout(0.2),

    tf.keras.layers.Flatten(),
    tf.keras.layers.Dense(128, activation='relu'),
    tf.keras.layers.Dropout(0.2),
    tf.keras.layers.Dense(10)
])

model.compile(optimizer='adam',
              loss=tf.keras.losses.SparseCategoricalCrossentropy(from_logits=True),
              metrics=['accuracy'])

lr_scheduler = tf.keras.callbacks.ReduceLROnPlateau( #讓學習率做調整訓練模型時不會在某些節點上震盪
    monitor='val_loss', #監測val_loss(不監測訓練損失率，因為訓練損失率低不一定代表模型訓練的好)
    factor=0.5, #驗證損失沒下降時，學習率減半
    patience=3, #連續3個epoch沒有進步就觸發
    min_lr=1e-6, #最低學習率限制
    verbose=1 #決定是否要顯示(0:關閉、1:顯示內容、2:不顯示進度條，只在完成後輸出一行摘要)
)

# 訓練模型 (將validation_data傳入以監控測試集狀況)
history = model.fit(
    train_images, train_labels,
    epochs=30,
    batch_size=128, #一次拿多少圖片更新一次權重(增加訓練速度用)預設是32
    validation_data=(test_images, test_labels),
    callbacks=[lr_scheduler] #預設callbacks=[]學習率是固定不變的值，加入先前設計的學習律調整
)

test_loss, test_acc = model.evaluate(test_images, test_labels, verbose=2) #回傳值(loss, accuracy)

print('\nTest accuracy:', test_acc)

#Logits（羅吉特值）是神經網路最後一層（通常是Dense層）直接輸出的原始分數，它們還不是機率。
#轉變成機率更方便後續畫圖使用
probability_model = tf.keras.Sequential([model,tf.keras.layers.Softmax()])
predictions = probability_model.predict(test_images)

def plot_image(i, predictions_array, true_label, img):
  true_label, img = true_label[i], img[i]
  plt.grid(False)
  plt.xticks([])
  plt.yticks([])

  plt.imshow(img, cmap=plt.cm.binary) #cm.binary 0是白色1是黑色更符合我們的設定讓物品以灰黑色呈現(cmap='gray'則是反過來)

  predicted_label = np.argmax(predictions_array) #predictions_array預測這一張圖時的結果 對這個結果取出最大值所在的位置（索引）
  if predicted_label == true_label:
    color = 'blue'
  else:
    color = 'red'

  plt.xlabel("{} {:2.0f}% ({})".format(class_names[predicted_label],
                      100*np.max(predictions_array), #將機率轉成百分比表示
                      class_names[true_label]),
                      color=color)

def plot_value_array(i, predictions_array, true_label):
  true_label = true_label[i]
  plt.grid(False)
  plt.xticks(range(10))
  plt.yticks([])
  thisplot = plt.bar(range(10), predictions_array, color="#777777")
  plt.ylim([0, 1])
  predicted_label = np.argmax(predictions_array)

  thisplot[predicted_label].set_color('red')
  thisplot[true_label].set_color('blue')


num_rows = 5
num_cols = 3
num_images = num_rows*num_cols
plt.figure(figsize=(2*2*num_cols, 2*num_rows))
for i in range(num_images):
  plt.subplot(num_rows, 2*num_cols, 2*i+1)
  plot_image(i, predictions[i], test_labels, test_images)
  plt.subplot(num_rows, 2*num_cols, 2*i+2)
  plot_value_array(i, predictions[i], test_labels)
plt.tight_layout()
plt.show()
